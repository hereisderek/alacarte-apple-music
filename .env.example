# Host path where downloaded music should end up (your main music library folder).
# Required — docker compose will refuse to start without this set.
MUSIC_PATH=/path/to/your/music/library

# Optional: host folder for app settings and the Apple session (web/ and
# wrapper/ subfolders). Defaults to ./data next to the compose file. Set an
# absolute path when your deploy tool (e.g. Portainer) resolves ./ per stack.
# ALACARTE_DATA_PATH=./data

# Port the web UI listens on (host side)
WEB_PORT=7373

# Secret used to encrypt Apple credentials at rest (64 hex chars = 32 bytes).
# If not set, one is generated on first run and stored in ./data/web/.secret
AMDL_SECRET_KEY=

# Restrict the web UI to the host machine only. Leave blank to publish on
# all interfaces (default; matches docker's behavior). Set to 127.0.0.1 if
# you front the app with a reverse proxy on the same host and don't want
# the UI directly reachable on your LAN.
WEB_BIND=

# Disable the built-in password gate. Only safe if you front the app with
# your own auth (reverse proxy auth, VPN, mesh network, etc.). Leave as
# false unless you really need it. When auth is enabled and no credentials
# exist yet, first-time setup also requires the one-time setup token from logs.
AUTH_DISABLED=false

# Trust proxy setting for Express. Keep "loopback" for local reverse-proxy
# setups. Use values like "1", "uniquelocal", or "true" only when you
# understand your proxy chain and forwarded headers.
TRUST_PROXY=loopback

# Optional: override the Docker network name. Defaults to "alacarte-net".
# DOCKER_NETWORK=alacarte-net

# Optional: set to "true" if you want to attach to an existing external network
# (e.g. one shared with Jellyfin/Plex). The network above must already exist.
# DOCKER_NETWORK_EXTERNAL=false

# Optional: Set the threshold for consecutive fatal errors (like CKC/DRM failures)
# before the download is automatically aborted. Default is 3.
# AMDL_MAX_DOWNLOAD_ERRORS=3

# Optional: Prefer IPv6 addresses when resolving DNS (e.g. for Apple Music CDN).
# Set to "true" if your host/network has a working IPv6 connection. Default is false.
# PREFER_IPV6=false

# --- Optional public import service (importer/) ---
# Only needed if you run `docker compose --profile importer up`.
# See importer/README.md for the full list of importer-specific variables.

# Shared secret between the web backend and the importer service. Required
# for the importer's /api/internal/* calls to work; generate any long random
# string (e.g. `openssl rand -hex 32`).
INTERNAL_API_KEY=

# Host port the importer listens on.
IMPORTER_PORT=8090

# Path prefix to serve the importer under (e.g. /sites/music-downloader).
# Leave blank to serve at the root. See importer/README.md if you're putting
# this behind a reverse-proxy subpath.
IMPORTER_BASE_PATH=/

# Turn on the importer's own username/password gate (recommended once this
# is reachable from the public internet).
IMPORTER_AUTH_ENABLED=false
IMPORTER_USERNAME=import
IMPORTER_PASSWORD=

# Minimum gap (ms) between the importer's catalog-search calls to Apple Music,
# enforced backend-side (protects the shared quota from any caller, not just
# the importer). Raise this if you still see 429 rate-limit errors on big
# imports; lower it if you have headroom to spare.
# INTERNAL_SEARCH_MIN_INTERVAL_MS=1500

# Extra client-side pacing/retry margin the importer adds on top of the above.
# Rarely need to change these.
# IMPORTER_SEARCH_PACING_MS=500
# IMPORTER_MAX_429_RETRIES=6
# IMPORTER_MAX_BACKOFF_MS=20000
# Maximum number of songs to import in one queue session (0 or unset = unlimited).
# If input exceeds this, only the first N songs are imported and a warning is shown.
# IMPORTER_MAX_TRACKS_PER_IMPORT=100

# User-Agent sent when fetching each source's page. IMPORTER_USER_AGENT is a
# generic fallback used by any parser without its own override below; only
# set the ones you actually need to change.
# IMPORTER_USER_AGENT=
# SPOTIFY_USER_AGENT=
# QISHUI_USER_AGENT=
# KKBOX_USER_AGENT=
# SILVERBOX_USER_AGENT=
# HOLIDAY_USER_AGENT=
